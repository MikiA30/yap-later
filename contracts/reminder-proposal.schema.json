{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Yap Later reminder proposal v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "title",
    "schedule",
    "clarification"
  ],
  "properties": {
    "status": {
      "enum": [
        "ready",
        "needs_clarification",
        "unsupported"
      ]
    },
    "title": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 250
    },
    "clarification": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 500
    },
    "schedule": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "offsetSeconds",
            "originalPhrase"
          ],
          "properties": {
            "kind": {
              "const": "relative"
            },
            "offsetSeconds": {
              "type": "integer",
              "minimum": 1
            },
            "originalPhrase": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "date",
            "time",
            "timeZoneID",
            "originalPhrase"
          ],
          "properties": {
            "kind": {
              "const": "calendar"
            },
            "date": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "time": {
              "type": "string",
              "pattern": "^\\d{2}:\\d{2}:\\d{2}$"
            },
            "timeZoneID": {
              "type": [
                "string",
                "null"
              ]
            },
            "originalPhrase": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "unspecified"
            }
          }
        }
      ]
    }
  }
}
